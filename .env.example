# Supabase (server-side only, service role — never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Polar checkout (server-side only — never expose the access token to the client)
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL=https://your-domain/welcome?checkout_id={CHECKOUT_ID}
POLAR_WEBHOOK_SECRET=

# Public: the Team product's ID, used to build the /api/checkout link.
# Until this is set, pricing CTAs fall back to the waitlist.
NEXT_PUBLIC_POLAR_TEAM_PRODUCT_ID=

# Resend (server-side only) — sends budget alert emails.
RESEND_API_KEY=

# Shared secret checked against the Authorization header on
# /api/cron/budget-check, so the scheduled job can't be triggered by
# anyone who finds the URL. Vercel Cron sends this automatically once set
# as a project env var; set the same value here for local testing.
CRON_SECRET=
